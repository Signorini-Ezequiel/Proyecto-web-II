// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider   = "prisma-client-js"
  output     = "../node_modules/.prisma/client"
  engineType = "binary"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  BUYER
  SELLER
  ADMIN
}

enum FuelType {
  GASOLINE
  DIESEL
  HYBRID
  ELECTRIC
  LPG
  CNG
  OTHER
}

enum Transmission {
  MANUAL
  AUTOMATIC
  SEMI_AUTOMATIC
}

model User {
  id               String      @id @default(uuid()) @db.Uuid
  name             String
  email            String      @unique
  password         String
  role             UserRole    @default(BUYER)
  avatar           String?
  refreshTokenHash String?
  questionThreads  QuestionThread[]
  questionMessages QuestionMessage[]
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt
}

model Car {
  id           String       @id @default(uuid()) @db.Uuid
  sellerId     String
  title        String
  brand        String
  model        String
  year         Int
  mileage      Int
  price        Decimal
  description  String
  color        String       @default("No especificado")
  horsepower   Int?
  engine       String?
  power        String?
  torque       String?
  acceleration String?
  topSpeed     String?
  consumption  String?
  dimensions   String?
  weight       String?
  features     String[]     @default([])
  fuelType     FuelType
  transmission Transmission
  location     String
  images       String[]
  isPublished  Boolean      @default(false)
  questionThreads  QuestionThread[]
  questionMessages QuestionMessage[]
  aiAnalyses        AIAnalysis[]
  imageAnalyses     ImageAnalysis[]
  deletedAt    DateTime?
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
}

model Favorite {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String
  carId     String
  createdAt DateTime @default(now())

  @@unique([userId, carId])
  @@index([userId])
  @@index([carId])
}

model Question {
  id        String   @id @default(uuid()) @db.Uuid
  buyerId   String
  sellerId  String?
  carId     String
  question  String
  answer    String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([carId])
  @@index([buyerId])
  @@index([sellerId])
}

model QuestionThread {
  id        String            @id @default(uuid()) @db.Uuid
  carId     String            @db.Uuid
  senderId  String            @db.Uuid
  car       Car               @relation(fields: [carId], references: [id], onDelete: Cascade)
  sender    User              @relation(fields: [senderId], references: [id], onDelete: Cascade)
  messages  QuestionMessage[]
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt

  @@index([carId])
  @@index([senderId])
}

model QuestionMessage {
  id         String         @id @default(uuid()) @db.Uuid
  threadId   String         @db.Uuid
  senderId   String         @db.Uuid
  senderRole UserRole
  carId      String         @db.Uuid
  content    String
  thread     QuestionThread @relation(fields: [threadId], references: [id], onDelete: Cascade)
  sender     User           @relation(fields: [senderId], references: [id], onDelete: Cascade)
  car        Car            @relation(fields: [carId], references: [id], onDelete: Cascade)
  createdAt  DateTime       @default(now())

  @@index([threadId])
  @@index([carId])
  @@index([senderId])
}

model AIAnalysis {
  id        String   @id @default(uuid()) @db.Uuid
  carId     String   @db.Uuid
  car       Car      @relation(fields: [carId], references: [id], onDelete: Cascade)
  dataHash  String
  model     String
  result    Json
  score     Int
  metadata  Json?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([carId])
  @@index([dataHash])
}

model ImageAnalysis {
  id        String   @id @default(uuid()) @db.Uuid
  carId     String   @db.Uuid
  car       Car      @relation(fields: [carId], references: [id], onDelete: Cascade)
  imageHash String
  model     String
  images    String[]
  result    Json
  score     Int
  metadata  Json?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([carId])
  @@index([imageHash])
}

model Comparison {
  id        String          @id @default(uuid()) @db.Uuid
  userId    String
  cars      ComparisonCar[]
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt
}

model ComparisonCar {
  comparisonId String     @db.Uuid
  carId        String
  comparison   Comparison @relation(fields: [comparisonId], references: [id], onDelete: Cascade)
  addedAt      DateTime   @default(now())

  @@id([comparisonId, carId])
}
